<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Portfolio & Bio Link</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        accent: {
                            50: 'var(--accent-50)',
                            400: 'var(--accent-400)',
                            500: 'var(--accent-500)',
                            600: 'var(--accent-600)',
                            700: 'var(--accent-700)',
                        }
                    },
                    animation: {
                        'glow-pulse': 'glow 3s infinite alternate',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        glow: {
                            '0%': { boxShadow: '0 0 15px rgba(124, 58, 237, 0.4), 0 0 30px rgba(124, 58, 237, 0.2)' },
                            '100%': { boxShadow: '0 0 25px rgba(168, 85, 247, 0.7), 0 0 50px rgba(168, 85, 247, 0.4)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-8px)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --accent-50: #f5f3ff;
            --accent-400: #a78bfa;
            --accent-500: #8b5cf6;
            --accent-600: #7c3aed;
            --accent-700: #6d28d9;
            --accent-glow: rgba(139, 92, 246, 0.35);
        }

        /* Glassmorphism utility classes */
        .glass-panel {
            background: rgba(17, 24, 39, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.45);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.07);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            background: rgba(30, 41, 59, 0.7);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px var(--accent-glow);
        }

        .glass-button {
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.2s ease;
        }

        .glass-button:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.25);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        /* Text gradient */
        .text-gradient {
            background: linear-gradient(135deg, #ffffff 0%, var(--accent-400) 50%, #e0e7ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="bg-[#07090e] text-slate-100 min-h-screen font-sans selection:bg-purple-500 selection:text-white relative overflow-x-hidden">

    <!-- Interactive Canvas Particle Background -->
    <canvas id="bg-canvas" class="fixed inset-0 pointer-events-none z-0 opacity-60"></canvas>

    <!-- Ambient Glowing Orbs Background -->
    <div class="fixed top-[-10%] left-[-10%] w-[45vw] h-[45vw] rounded-full bg-purple-900/20 blur-[130px] pointer-events-none z-0"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-[45vw] h-[45vw] rounded-full bg-indigo-900/20 blur-[130px] pointer-events-none z-0"></div>
    <div class="fixed top-[40%] right-[20%] w-[30vw] h-[30vw] rounded-full bg-blue-900/15 blur-[120px] pointer-events-none z-0"></div>

    <!-- Main Container -->
    <div class="relative z-10 max-w-2xl mx-auto px-4 py-8 md:py-12 flex flex-col min-h-screen">

        <!-- Top Action Bar -->
        <header class="flex items-center justify-between mb-8 glass-panel px-4 py-3 rounded-2xl">
            <!-- Dynamic Status Badge -->
            <div id="status-badge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span id="display-status-text">Open for Collaboration</span>
            </div>

            <!-- Quick Action Controls -->
            <div class="flex items-center gap-2">
                <!-- Quick Share Button -->
                <button onclick="openShareModal()" title="Bagikan Profil" class="glass-button w-9 h-9 rounded-xl flex items-center justify-center text-slate-300 hover:text-white transition">
                    <i class="fa-solid fa-share-nodes text-sm"></i>
                </button>
                <!-- Quick Sound Vibe Toggle -->
                <button id="sound-btn" onclick="toggleAudio()" title="Sound FX" class="glass-button w-9 h-9 rounded-xl flex items-center justify-center text-slate-300 hover:text-white transition">
                    <i id="sound-icon" class="fa-solid fa-volume-xmark text-sm"></i>
                </button>
                <!-- Edit & Customization Toggle Button -->
                <button onclick="toggleEditPanel()" class="px-3.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-medium text-xs shadow-lg shadow-purple-600/30 flex items-center gap-1.5 transition active:scale-95">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Edit Profile</span>
                </button>
            </div>
        </header>

        <!-- Profile Hero Section -->
        <section class="glass-panel p-6 sm:p-8 rounded-3xl mb-8 relative overflow-hidden text-center shadow-2xl">
            <!-- Decorative Banner Glow -->
            <div class="absolute top-0 left-0 right-0 h-28 bg-gradient-to-r from-purple-600/20 via-indigo-600/20 to-pink-600/20 blur-xl pointer-events-none"></div>

            <!-- Profile Avatar Frame with Live Change Photo Feature -->
            <div class="relative inline-block mb-5 group">
                <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-full p-1 bg-gradient-to-tr from-purple-500 via-indigo-500 to-pink-500 animate-glow-pulse shadow-xl relative mx-auto">
                    <img id="avatar-img" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80" alt="Avatar" class="w-full h-full object-cover rounded-full bg-slate-900 border-2 border-slate-900">
                </div>
                
                <!-- Quick Upload Photo Overlay Button -->
                <label for="avatar-file-input" class="absolute bottom-0 right-0 bg-purple-600 hover:bg-purple-500 text-white p-2.5 rounded-full shadow-lg cursor-pointer transition transform hover:scale-110 border-2 border-slate-900 flex items-center justify-center" title="Ganti Foto">
                    <i class="fa-solid fa-camera text-xs"></i>
                </label>
                <input type="file" id="avatar-file-input" accept="image/*" class="hidden" onchange="handleAvatarUpload(event)">
            </div>

            <!-- Profile Info Header -->
            <div class="space-y-2">
                <div class="flex items-center justify-center gap-2">
                    <h1 id="display-name" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight text-gradient">Alfari Rizky</h1>
                    <span class="text-purple-400 text-lg" title="Verified Creator"><i class="fa-solid fa-circle-check"></i></span>
                </div>
                
                <p id="display-tagline" class="text-sm sm:text-base font-medium text-purple-300/90">Creative Developer & Digital Architect 🚀</p>
                
                <div class="flex items-center justify-center gap-4 text-xs text-slate-400 pt-1">
                    <span id="display-location" class="flex items-center gap-1"><i class="fa-solid fa-location-dot text-purple-400"></i> Jakarta, Indonesia</span>
                    <span>•</span>
                    <span id="display-joined" class="flex items-center gap-1"><i class="fa-solid fa-calendar text-purple-400"></i> Joined 2024</span>
                </div>
            </div>

            <!-- Profile Bio Description -->
            <p id="display-bio" class="mt-4 text-sm text-slate-300 leading-relaxed max-w-lg mx-auto">
                Membangun pengalaman web modern, antarmuka elegan, dan ekosistem digital interaktif. Terbuka untuk proyek freelance, kolaborasi, dan diskusi ide kreatif.
            </p>

            <!-- Quick Stats Counters Bar -->
            <div class="grid grid-cols-4 gap-2 sm:gap-4 mt-6 pt-6 border-t border-slate-800/80">
                <div class="p-2 rounded-2xl bg-slate-800/30 border border-slate-700/30">
                    <div id="stat-1-val" class="text-base sm:text-lg font-bold text-white">45+</div>
                    <div id="stat-1-lbl" class="text-[10px] sm:text-xs text-slate-400">Projects</div>
                </div>
                <div class="p-2 rounded-2xl bg-slate-800/30 border border-slate-700/30">
                    <div id="stat-2-val" class="text-base sm:text-lg font-bold text-white">1.2k</div>
                    <div id="stat-2-lbl" class="text-[10px] sm:text-xs text-slate-400">Coffees</div>
                </div>
                <div class="p-2 rounded-2xl bg-slate-800/30 border border-slate-700/30">
                    <div id="stat-3-val" class="text-base sm:text-lg font-bold text-white">5+</div>
                    <div id="stat-3-lbl" class="text-[10px] sm:text-xs text-slate-400">Years Exp</div>
                </div>
                <div class="p-2 rounded-2xl bg-slate-800/30 border border-slate-700/30">
                    <div id="stat-4-val" class="text-base sm:text-lg font-bold text-white">4.9★</div>
                    <div id="stat-4-lbl" class="text-[10px] sm:text-xs text-slate-400">Rating</div>
                </div>
            </div>
        </section>

        <!-- Tabbed Navigation Switcher -->
        <div class="flex p-1.5 rounded-2xl glass-panel mb-6 space-x-1">
            <button onclick="switchTab('links')" id="tab-btn-links" class="flex-1 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 bg-purple-600 text-white shadow-md">
                <i class="fa-solid fa-link text-xs"></i>
                <span>Tautan Saya</span>
            </button>
            <button onclick="switchTab('about')" id="tab-btn-about" class="flex-1 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 text-slate-400 hover:text-white">
                <i class="fa-solid fa-user text-xs"></i>
                <span>Keahlian & Bio</span>
            </button>
            <button onclick="switchTab('projects')" id="tab-btn-projects" class="flex-1 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 text-slate-400 hover:text-white">
                <i class="fa-solid fa-layer-group text-xs"></i>
                <span>Showcase</span>
            </button>
        </div>

        <!-- TAB CONTENT 1: LINKS CONTAINER -->
        <main id="tab-content-links" class="space-y-3.5 mb-12">
            <!-- Dynamic links list will be rendered here via JS -->
            <div id="links-container" class="space-y-3.5"></div>
        </main>

        <!-- TAB CONTENT 2: ABOUT & SKILLS CONTAINER -->
        <div id="tab-content-about" class="space-y-6 mb-12 hidden">
            <!-- Skill Badges Panel -->
            <div class="glass-panel p-6 rounded-3xl space-y-4">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-code text-purple-400"></i>
                    <span>Keahlian & Spesialisasi</span>
                </h3>
                <p class="text-xs text-slate-400">Teknologi dan tools yang sering saya gunakan dalam pengembangan software.</p>
                
                <div class="flex flex-wrap gap-2 pt-2" id="skills-container">
                    <!-- Skills pills dynamically rendered -->
                </div>
            </div>

            <!-- Mini Experience Timeline -->
            <div class="glass-panel p-6 rounded-3xl space-y-4">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-briefcase text-purple-400"></i>
                    <span>Pengalaman Ringkas</span>
                </h3>

                <div class="space-y-4 border-l-2 border-slate-800 ml-2 pl-4">
                    <div class="relative">
                        <div class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-purple-500 ring-4 ring-slate-900"></div>
                        <h4 class="text-sm font-bold text-white">Senior Web Developer</h4>
                        <span class="text-[11px] text-purple-300">2023 - Sekarang • Remote</span>
                        <p class="text-xs text-slate-400 mt-1">Mengembangkan sistem frontend SaaS berkinerja tinggi dan landing page interaktif modern.</p>
                    </div>

                    <div class="relative">
                        <div class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full bg-indigo-500 ring-4 ring-slate-900"></div>
                        <h4 class="text-sm font-bold text-white">UI/UX & Digital Designer</h4>
                        <span class="text-[11px] text-purple-300">2021 - 2023 • Studio Creatives</span>
                        <p class="text-xs text-slate-400 mt-1">Merancang sistem desain, wireframe, serta pengalaman pengguna yang human-centered.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB CONTENT 3: PROJECTS SHOWCASE CONTAINER -->
        <div id="tab-content-projects" class="space-y-4 mb-12 hidden">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="projects-container">
                <!-- Projects cards rendered dynamically -->
            </div>
        </div>

        <!-- Footer -->
        <footer class="mt-auto text-center pt-8 border-t border-slate-800/60 pb-6 text-xs text-slate-500">
            <p>© <span id="footer-year"></span> <span id="footer-name">Alfari Rizky</span>. Crafted with <i class="fa-solid fa-heart text-purple-500"></i> & Glassmorphism UI</p>
            <p class="mt-1 text-[11px] text-slate-600">Klik "Edit Profile" di kanan atas untuk mengganti foto, nama & link kamu secara langsung.</p>
        </footer>

    </div>

    <!-- MODAL 1: REAL-TIME EDITING & CUSTOMIZATION PANEL -->
    <div id="edit-modal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="glass-panel bg-slate-900/95 max-w-xl w-full rounded-3xl max-h-[90vh] flex flex-col border border-slate-700/50 shadow-2xl overflow-hidden">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-800">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-xl bg-purple-600/20 text-purple-400 flex items-center justify-center">
                        <i class="fa-solid fa-sliders"></i>
                    </div>
                    <h3 class="font-bold text-white text-base">Edit Profile & Link</h3>
                </div>
                <button onclick="toggleEditPanel()" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Scrollable Content -->
            <div class="p-6 space-y-6 overflow-y-auto">

                <!-- 1. Photo Upload & Preview Section -->
                <div class="space-y-3">
                    <label class="block text-xs font-semibold text-purple-300 uppercase tracking-wider">Foto Profil (Avatar)</label>
                    <div class="flex items-center gap-4 p-3 rounded-2xl bg-slate-800/40 border border-slate-700/50">
                        <img id="edit-avatar-preview" src="" alt="Preview" class="w-16 h-16 rounded-full object-cover border border-purple-500/50">
                        <div class="space-y-2 flex-1">
                            <div class="flex items-center gap-2">
                                <label for="modal-file-input" class="px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-medium cursor-pointer transition inline-flex items-center gap-1.5">
                                    <i class="fa-solid fa-upload"></i>
                                    <span>Upload Foto Baru</span>
                                </label>
                                <input type="file" id="modal-file-input" accept="image/*" class="hidden" onchange="handleAvatarUpload(event)">
                            </div>
                            <input type="text" id="input-avatar-url" placeholder="Atau paste URL Foto langsung di sini..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-purple-500">
                        </div>
                    </div>
                </div>

                <!-- 2. Personal Info Fields -->
                <div class="space-y-3">
                    <label class="block text-xs font-semibold text-purple-300 uppercase tracking-wider">Informasi Diri</label>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1">Nama Lengkap</label>
                            <input type="text" id="input-name" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-purple-500">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1">Status Badge</label>
                            <input type="text" id="input-status" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-purple-500">
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11px] text-slate-400 mb-1">Tagline / Profesi</label>
                        <input type="text" id="input-tagline" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-purple-500">
                    </div>

                    <div>
                        <label class="block text-[11px] text-slate-400 mb-1">Lokasi</label>
                        <input type="text" id="input-location" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-purple-500">
                    </div>

                    <div>
                        <label class="block text-[11px] text-slate-400 mb-1">Bio Singkat</label>
                        <textarea id="input-bio" rows="3" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-purple-500"></textarea>
                    </div>
                </div>

                <!-- 3. Accent Theme Selector -->
                <div class="space-y-3">
                    <label class="block text-xs font-semibold text-purple-300 uppercase tracking-wider">Tema Warna Aksens</label>
                    <div class="flex items-center gap-3">
                        <button onclick="setThemeAccent('purple')" class="w-8 h-8 rounded-full bg-purple-600 ring-2 ring-white/20 hover:scale-110 transition" title="Purple Aurora"></button>
                        <button onclick="setThemeAccent('emerald')" class="w-8 h-8 rounded-full bg-emerald-500 ring-2 ring-white/20 hover:scale-110 transition" title="Emerald Glow"></button>
                        <button onclick="setThemeAccent('cyan')" class="w-8 h-8 rounded-full bg-cyan-500 ring-2 ring-white/20 hover:scale-110 transition" title="Electric Cyan"></button>
                        <button onclick="setThemeAccent('rose')" class="w-8 h-8 rounded-full bg-rose-500 ring-2 ring-white/20 hover:scale-110 transition" title="Rose Gold"></button>
                        <button onclick="setThemeAccent('amber')" class="w-8 h-8 rounded-full bg-amber-500 ring-2 ring-white/20 hover:scale-110 transition" title="Sunset Amber"></button>
                    </div>
                </div>

                <!-- 4. Manage Custom Links -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-semibold text-purple-300 uppercase tracking-wider">Kelola Tautan Sosial & Portfolio</label>
                        <button onclick="addNewLink()" class="text-xs text-purple-400 hover:text-purple-300 flex items-center gap-1 font-medium">
                            <i class="fa-solid fa-plus"></i> Tambah Link Baru
                        </button>
                    </div>
                    <div id="modal-links-editor" class="space-y-2.5 max-h-56 overflow-y-auto pr-1">
                        <!-- Dynamic Link Inputs rendered here -->
                    </div>
                </div>

            </div>

            <!-- Modal Footer Controls -->
            <div class="flex items-center justify-between px-6 py-4 border-t border-slate-800 bg-slate-900">
                <button onclick="resetToDefaults()" class="px-4 py-2 rounded-xl border border-rose-500/30 text-rose-400 hover:bg-rose-500/10 text-xs font-medium transition">
                    Reset Default
                </button>
                <div class="flex gap-2">
                    <button onclick="toggleEditPanel()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition">
                        Batal
                    </button>
                    <button onclick="saveProfileChanges()" class="px-5 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition shadow-lg shadow-purple-600/30">
                        Simpan Perubahan
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 2: SHARE & QR CODE MODAL -->
    <div id="share-modal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="glass-panel bg-slate-900/95 max-w-sm w-full rounded-3xl p-6 text-center border border-slate-700/50 shadow-2xl relative">
            <button onclick="closeShareModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>

            <div class="w-12 h-12 rounded-2xl bg-purple-600/20 text-purple-400 mx-auto flex items-center justify-center mb-4">
                <i class="fa-solid fa-qrcode text-xl"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-1">Bagikan Kartu Digital</h3>
            <p class="text-xs text-slate-400 mb-5">Pindai QR code di bawah ini untuk langsung membuka profil kamu di smartphone.</p>

            <!-- Dynamic QR Code Container -->
            <div class="bg-white p-4 rounded-2xl inline-block mb-5 shadow-inner">
                <img id="qr-code-img" src="" alt="QR Code" class="w-40 h-40">
            </div>

            <!-- Share URL Action Bar -->
            <div class="flex items-center gap-2 bg-slate-950 p-2 rounded-xl border border-slate-800">
                <input type="text" id="share-url-input" readonly class="bg-transparent text-xs text-slate-300 px-2 flex-1 focus:outline-none">
                <button onclick="copyProfileLink()" class="px-3 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold transition">
                    <i class="fa-solid fa-copy mr-1"></i> Salin
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION CONTAINER -->
