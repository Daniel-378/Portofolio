            if (!isPlayingAudio) {
                try {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    audioCtx = new AudioContext();
                    ambientOsc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();

                    ambientOsc.type = 'sine';
                    ambientOsc.frequency.setValueAtTime(220, audioCtx.currentTime); // Chill A3 note
                    gain.gain.setValueAtTime(0.015, audioCtx.currentTime); // Soft volume

                    ambientOsc.connect(gain);
                    gain.connect(audioCtx.destination);
                    ambientOsc.start();

                    isPlayingAudio = true;
                    soundIcon.className = "fa-solid fa-volume-high text-sm text-purple-400";
                    showToast('Efek suara ambient aktif');
                } catch (e) {
                    showToast('Audio tidak didukung di peramban ini');
